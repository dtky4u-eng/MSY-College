# Local development configuration. Copy to .env and adjust for production.
DATABASE_URL="file:./dev.db"

# Secrets used to sign JWTs and the sandbox gateway. CHANGE IN PRODUCTION.
JWT_SECRET="change-me-to-a-long-random-string"
SANDBOX_GATEWAY_SECRET="change-me"

# Public base URL (used in QR codes, emails and gateway return URLs)
APP_URL="http://localhost:3000"

# Payment gateway: "auto" | "razorpay" | "cashfree" | "sandbox".
# "auto" picks Razorpay if its keys are set, else Cashfree, else the built-in sandbox.
PAYMENT_GATEWAY="auto"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"

# Where uploaded files are stored (outside /public, served through access-checked routes)
STORAGE_DIR="./storage"

# Emails (e.g. password reset links) are written to storage/outbox and the server log.
MAIL_FROM="MSY College <helpdesk@msycollege.org>"

